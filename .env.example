# Copy this file to `.env.local` and fill in real values.
# Vite only exposes variables prefixed with VITE_ to the client bundle.

# ---- Supabase ----
# Project Settings → API
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# ---- Polar ----
# Create a Product in Polar (https://polar.sh) at $20 / month and paste the
# checkout link here. Polar checkout links look like:
#   https://buy.polar.sh/polar_cl_XXXXXXXXXXXX
# (Sandbox links live under https://sandbox.polar.sh/...)
VITE_POLAR_PRO_CHECKOUT_URL=https://buy.polar.sh/polar_cl_REPLACE_ME

# Where the "Contact us" button on the Team tier should go.
# Use a mailto: or a typeform/cal.com link.
VITE_POLAR_TEAM_CONTACT_URL=mailto:atogambayev@gmail.com;subject=Deka%20Team%20plan
