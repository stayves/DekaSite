# Copy this file to `.env.local` and fill in real values.
# Vite only exposes variables prefixed with VITE_ to the client bundle.
# Variables WITHOUT the VITE_ prefix are server-side only — used by the
# Vercel serverless function in /api and never sent to the browser.

# ---- Supabase ----
# Project Settings → API
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# ---- Metered model proxy (Cloudflare Worker, DekaSite/proxy) ----
# The Account page reads <proxy>/v1/usage with the user's JWT to show how much
# of the period allowance is left. Leave blank to hide the usage meter.
VITE_PROXY_URL=https://deka-proxy.YOUR-SUBDOMAIN.workers.dev

# Project Settings → API → "service_role" key (KEEP SECRET — full DB access).
# Used by the /api/polar-webhook serverless function to write subscription
# rows. Do NOT prefix with VITE_ or it will leak to the client.
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# ---- Polar ----
# Sandbox: https://sandbox.polar.sh    Production: https://polar.sh
#
# 1. Create a Product priced at $20/month (the Personal plan), copy its Checkout
#    Link: https://buy.polar.sh/polar_cl_XXXXXXXXXXXX  (or sandbox.polar.sh/...)
VITE_POLAR_PRO_CHECKOUT_URL=https://buy.polar.sh/polar_cl_REPLACE_ME

# 1b. Create a SECOND Product priced at $60/month (the Team plan) and copy its
#     Checkout Link here. The "Start Team" button uses this.
VITE_POLAR_TEAM_CHECKOUT_URL=https://buy.polar.sh/polar_cl_REPLACE_ME

# 1c. The Team product's id (Polar dashboard → Products → the Team product).
#     Server-only (no VITE_ prefix) — the webhook compares each subscription's
#     product_id against this to tag the row tier='team' (else 'pro').
POLAR_TEAM_PRODUCT_ID=

# 2. Customer portal URL — Polar dashboard → Settings → "Customer Portal".
#    Looks like https://polar.sh/<org>/portal (or sandbox.polar.sh/<org>/portal).
VITE_POLAR_CUSTOMER_PORTAL_URL=https://polar.sh/YOUR-ORG/portal

# 3. Webhook secret — create a webhook in Polar (Settings → Webhooks):
#    URL: https://YOUR-DOMAIN/api/polar-webhook
#    Events: subscription.created, subscription.updated,
#            subscription.canceled, subscription.revoked
#    Polar will show a signing secret starting with "whsec_".
POLAR_WEBHOOK_SECRET=whsec_REPLACE_ME

# Where the pricing-page "Talk to us" contact link should go (Team is now a
# self-serve checkout, so this is just a general sales/contact link).
# Use a mailto: or a typeform/cal.com link.
VITE_POLAR_TEAM_CONTACT_URL=mailto:atogambayev@gmail.com?subject=Deka%20Team%20plan
